---
// Barra superior fija: transparente sobre el inicio; al desplazarse toma fondo, desenfoque y línea.
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../site';

const secciones = [
  { href: '#experiencia', label: 'Experiencia' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#metodo', label: 'Método' },
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#herramientas', label: 'Herramientas' },
  { href: '#contacto', label: 'Contacto' },
];
---

<!-- Centinela: mientras está en pantalla, la página no se ha desplazado. -->
<div class="absolute top-0 h-px w-px" aria-hidden="true" data-centinela></div>
<header class="barra sticky top-0 z-40 border-b border-transparent" data-barra>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="#inicio" class="font-display font-semibold tracking-tight">{site.name}</a>
    <nav aria-label="Secciones" class="flex items-center gap-6 text-sm text-muted">
      {secciones.map((s) => <a class="hidden transition-colors hover:text-ink md:inline" href={s.href}>{s.label}</a>)}
      <ThemeToggle class="grid size-9 place-items-center transition-colors hover:text-ink" />
    </nav>
  </div>
</header>

<script>
  // Sin escuchar cada evento de scroll: un IntersectionObserver sobre el centinela.
  const barra = document.querySelector<HTMLElement>('[data-barra]')!;
  const centinela = document.querySelector('[data-centinela]')!;
  new IntersectionObserver(([e]) => barra.toggleAttribute('data-scrolled', !e.isIntersecting)).observe(centinela);
</script>

<style>
  .barra {
    transition:
      background-color 300ms ease,
      border-color 300ms ease;
  }
  .barra[data-scrolled] {
    background: color-mix(in oklch, var(--color-bg) 88%, transparent);
    border-bottom-color: var(--color-ink);
    backdrop-filter: blur(10px);
  }
</style>
