---
// Sobre mí: su frase sobre el diferencial destacada, el resto del texto y lo personal como la
// simbología de un plano. Todo el texto viene de su perfil de LinkedIn (site.ts → about).
import Eje from './Eje.astro';
import Titulo from './Titulo.astro';
import { about } from '../site';

const [explorar, diferencial, persona, fueraDelTrabajo] = about;
const simbolos = [
  { label: 'Gimnasio', trazo: 'M8 24v16 M14 18v28 M14 32h36 M50 18v28 M56 24v16' },
  { label: 'Videojuegos', trazo: 'M18 22h28c6 0 10 6 11 14s-1 14-6 14-7-6-12-6H25c-5 0-7 6-12 6s-7-6-6-14 5-14 11-14Z M20 30v8 M16 34h8 M42 32h.01 M47 36h.01' },
  { label: 'Música', trazo: 'M24 46V14l26-6v32 M24 46a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z M50 40a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z' },
];
---

<section id="sobre-mi" aria-labelledby="t-sobre-mi" class="mx-auto max-w-6xl px-5 py-20">
  <Eje letra="D" />
  <Titulo id="t-sobre-mi">Sobre mí</Titulo>
  <div class="aparecer-grupo mt-10 grid gap-12 lg:grid-cols-[1fr_19rem]">
    <div>
      <p class="font-display text-[clamp(1.375rem,2.6vw,2rem)] leading-snug font-medium tracking-tight text-balance">
        <span class="text-obra" aria-hidden="true">“</span>{diferencial}<span class="text-obra" aria-hidden="true">”</span>
      </p>
      <div class="mt-8 grid max-w-[65ch] gap-4 leading-relaxed text-pretty text-muted">
        <p>{explorar}</p>
        <p>{persona}</p>
      </div>
    </div>
    <aside class="self-start border-2 border-ink bg-surface" aria-label="Fuera del trabajo">
      <p class="code border-b-2 border-ink px-4 py-2 text-xs text-muted">simbología · fuera del trabajo</p>
      <ul>
        {
          simbolos.map((s) => (
            <li class="flex items-center gap-4 border-b border-line px-4 py-3">
              <svg viewBox="0 0 64 64" class="size-9 shrink-0 text-obra-texto" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={s.trazo} />
              </svg>
              <span class="font-medium">{s.label}</span>
            </li>
          ))
        }
      </ul>
      <p class="px-4 py-3 text-sm leading-relaxed text-muted">{fueraDelTrabajo}</p>
    </aside>
  </div>
</section>
