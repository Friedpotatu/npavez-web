---
import Base from '../layouts/Base.astro';
import { site } from '../site';
---

<Base title={`Página no encontrada · ${site.name}`} noindex>
  <main id="contenido" class="mx-auto grid min-h-dvh max-w-3xl content-center px-5">
    <p class="text-sm text-muted">Error 404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">Esta página no existe</h1>
    <p class="mt-3 text-muted">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <p class="mt-8">
      <a href="/" class="bg-ink px-4 py-2 text-sm font-medium text-bg transition-opacity hover:opacity-85">
        Volver al inicio
      </a>
    </p>
  </main>
</Base>
